---
const year = new Date().getFullYear();
---
<footer class="border-t border-line rack-ear mt-16">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs text-dim">
    <span>© {year} yourname — uptime since day one</span>
    <div class="flex gap-4">
      <a href="mailto:you@yourdomain.com" class="hover:text-signal transition-colors">email</a>
      <a href="https://github.com/yourname" class="hover:text-signal transition-colors">github</a>
      <a href="https://linkedin.com/in/yourname" class="hover:text-signal transition-colors">linkedin</a>
    </div>
  </div>
</footer>
