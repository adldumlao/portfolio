---
import Layout from '../layouts/Layout.astro';

const hardware = [
  { unit: "1U", device: "Dell R730xd", role: "Primary compute / Proxmox host", status: "online" },
  { unit: "1U", device: "Raspberry Pi 4", role: "Monitoring (Prometheus + Uptime Kuma)", status: "online" },
  { unit: "1U", device: "Synology DS920+", role: "Bulk storage / backups", status: "online" },
  { unit: "—",  device: "UniFi Dream Machine", role: "Router / firewall", status: "online" },
];

const stack = [
  "Proxmox VE", "Docker", "Nginx Proxy Manager", "Cloudflare Tunnel",
  "Prometheus", "Grafana", "Uptime Kuma", "Pi-hole", "TrueNAS", "Ansible"
];
---
<Layout title="homelab" description="The hardware and software running this home lab.">
  <p class="font-mono text-xs text-signal mb-4">// U2 — homelab</p>
  <h1 class="text-3xl sm:text-4xl font-bold mb-3">Home Lab</h1>
  <p class="text-dim max-w-xl leading-relaxed mb-12">
    What's actually running in the rack right now. Update this page as
    hardware comes and goes — it's meant to drift, not stay static.
  </p>

  <h2 class="font-mono text-xs text-dim mb-4 tracking-wider">RACK INVENTORY</h2>
  <div class="border border-line rounded-sm overflow-hidden mb-14 overflow-x-auto">
    <table class="w-full text-sm min-w-[480px]">
      <thead>
        <tr class="bg-panel font-mono text-xs text-dim text-left">
          <th class="px-4 py-3 font-medium">Unit</th>
          <th class="px-4 py-3 font-medium">Device</th>
          <th class="px-4 py-3 font-medium">Role</th>
          <th class="px-4 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody>
        {hardware.map(h => (
          <tr class="border-t border-line">
            <td class="px-4 py-3 font-mono text-xs text-dim">{h.unit}</td>
            <td class="px-4 py-3 font-medium">{h.device}</td>
            <td class="px-4 py-3 text-dim">{h.role}</td>
            <td class="px-4 py-3">
              <span class="font-mono text-[10px] text-signal inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-signal status-dot"></span>
                {h.status.toUpperCase()}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="font-mono text-xs text-dim mb-4 tracking-wider">SOFTWARE STACK</h2>
  <ul class="flex flex-wrap gap-2 mb-14">
    {stack.map(s => (
      <li class="font-mono text-xs border border-line bg-panel px-3 py-1.5 rounded-sm">{s}</li>
    ))}
  </ul>

  <h2 class="font-mono text-xs text-dim mb-4 tracking-wider">NETWORK DIAGRAM</h2>
  <div class="border border-line bg-panel rounded-sm aspect-video flex items-center justify-center text-dim text-sm font-mono rack-ear">
    drop your Excalidraw / draw.io export here
  </div>
</Layout>
