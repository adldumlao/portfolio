---
interface Props { status: 'active' | 'wip' | 'archived' }
const { status } = Astro.props;
const map = {
  active:   { classes: 'bg-signal/15 text-signal',   label: 'Active' },
  wip:      { classes: 'bg-accent2/15 text-accent2', label: 'In Progress' },
  archived: { classes: 'bg-dim/15 text-dim',         label: 'Archived' },
};
const { classes, label } = map[status];
---
<span class:list={["text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap", classes]}>
  {label}
</span>
