---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={project.data.title} description={project.data.description}>
  <a href="/#projects" class="text-sm text-dim hover:text-signal transition-colors mb-8 inline-block">
    ← Back to projects
  </a>

  <div class="flex items-center justify-between gap-4 mb-3 flex-wrap">
    <h1 class="text-3xl sm:text-4xl font-extrabold">{project.data.title}</h1>
    <StatusBadge status={project.data.status} />
  </div>

  <p class="text-dim text-base leading-relaxed mb-6 max-w-2xl">{project.data.description}</p>

  <div class="flex flex-wrap gap-2 mb-8">
    {project.data.stack.map(s => (
      <span class="text-xs border border-line bg-panel px-3 py-1 rounded-full text-dim">{s}</span>
    ))}
  </div>

  <div class="flex gap-3 mb-12 text-sm">
    {project.data.repoUrl && (
      <a href={project.data.repoUrl} class="border border-line px-4 py-2 rounded-lg hover:border-signal hover:text-signal transition-colors">
        View repo →
      </a>
    )}
    {project.data.demoUrl && (
      <a href={project.data.demoUrl} class="border border-line px-4 py-2 rounded-lg hover:border-signal hover:text-signal transition-colors">
        Live demo →
      </a>
    )}
  </div>

  <article class="prose prose-invert max-w-2xl leading-relaxed
    prose-headings:font-bold prose-headings:mb-3 prose-headings:mt-8
    prose-p:text-dim prose-li:text-dim prose-a:text-signal prose-strong:text-ink
    prose-code:text-sm prose-code:bg-panel prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded">
    <Content />
  </article>
</Layout>
