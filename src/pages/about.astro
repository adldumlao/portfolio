---
import Layout from '../layouts/Layout.astro';

const skills = [
  "Linux Administration", "Docker & Compose", "Networking", "Proxmox",
  "CI/CD", "Python", "TypeScript", "Self-Hosting"
];
---
<Layout title="about" description="About me — background, skills, and how I got into building things.">
  <p class="font-mono text-xs text-signal mb-4">// U1 — about</p>
  <h1 class="text-3xl sm:text-4xl font-bold mb-8">About</h1>

  <div class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-8 sm:gap-10 mb-14">
    <div class="w-full aspect-square bg-panel border border-line rounded-sm rack-ear"></div>
    <div class="space-y-4 text-dim leading-relaxed">
      <p>
        Hi, I'm Arnel Dean Dumlao. Replace this paragraph with two or three
        sentences on who you are, what you do day-to-day, and what pulled
        you toward infrastructure and self-hosting in the first place.
      </p>
      <p>
        Add a second paragraph here — what you're focused on right now,
        or a specific thread (a role, a niche, a long-running project)
        that ties your work together.
      </p>
    </div>
  </div>

  <p class="font-mono text-xs text-dim mb-4">installed modules</p>
  <ul class="flex flex-wrap gap-2">
    {skills.map(s => (
      <li class="font-mono text-xs border border-line bg-panel px-3 py-1.5 rounded-sm text-ink">
        {s}
      </li>
    ))}
  </ul>
</Layout>
