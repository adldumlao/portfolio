---
const links = [
  { href: '/', label: 'index' },
  { href: '/about', label: 'about' },
  { href: '/homelab', label: 'homelab' },
  { href: '/projects', label: 'projects' },
];
const current = Astro.url.pathname;
---
<header class="border-b border-line rack-ear">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-4 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-ink tracking-tight">
      ~/yourname<span class="text-signal">$</span>
    </a>

    <nav class="hidden sm:flex items-center gap-6 font-mono text-sm">
      {links.map(l => (
        <a
          href={l.href}
          class:list={[
            "text-dim hover:text-signal transition-colors",
            current === l.href && "text-signal"
          ]}
        >
          /{l.label}
        </a>
      ))}
    </nav>

    <div class="hidden sm:flex items-center gap-2 font-mono text-xs text-dim">
      <span class="w-2 h-2 rounded-full bg-signal status-dot crt-flicker"></span>
      SYSTEM ONLINE
    </div>

    <button
      id="nav-toggle"
      class="sm:hidden font-mono text-sm text-ink border border-line rounded px-3 py-1"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      menu
    </button>
  </div>

  <nav id="mobile-nav" class="sm:hidden hidden border-t border-line px-5 py-3 flex flex-col gap-3 font-mono text-sm">
    {links.map(l => (
      <a
        href={l.href}
        class:list={[
          "text-dim hover:text-signal transition-colors",
          current === l.href && "text-signal"
        ]}
      >
        /{l.label}
      </a>
    ))}
    <div class="flex items-center gap-2 text-xs text-dim pt-2 border-t border-line">
      <span class="w-2 h-2 rounded-full bg-signal status-dot"></span>
      SYSTEM ONLINE
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(isHidden));
    btn.textContent = isHidden ? 'close' : 'menu';
  });
</script>
